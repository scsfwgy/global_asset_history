ntributor": null, "rationale": "Sitemap and JSON-LD use fixed dates (INDEX_LASTMOD, ETF_MARKET_LASTMOD, KNOWLEDGE_ARTICLES.updated) rather than datetime.now() to avoid spurious diff churn and keep SEO signals stable."}, {"id": "CLAUDE_no_build_tools_constraint", "label": "No React/Vue/Build Tools \u2014 Classic JS Only", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend uses native HTML/CSS/classic JavaScript with SVG charts; no Node.js build pipeline, no framework. Keeps deployment simple and avoids build-step complexity on Vercel."}, {"id": "CLAUDE_data_source_fallback_strategy", "label": "Data Source Fallback Chain", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "US stocks\u2192Yahoo Finance; crypto\u2192Binance\u2192OKX\u2192CoinGecko; A-shares\u2192East Money/Tencent. Single upstream failure must not cascade; ThreadPoolExecutor for concurrent fetches."}, {"id": "CLAUDE_native_svg_charts", "label": "Native SVG Charts \u2014 no charting library", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_internationalization", "label": "i18n \u2014 zh-CN and en locales", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_start_sh", "label": "start.sh \u2014 unified dev lifecycle script", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_pytest_discipline", "label": "Mandatory pytest Before Any Start", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "start.sh debug/start/restart all enforce pytest pass before launching Flask. Prevents broken code from reaching runtime. 306 tests covering computation, services, routes, ETF/QDII, SEO, stats, and logging."}, {"id": "CLAUDE_conventional_commits", "label": "Conventional Commits format", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_no_auto_commit_rule", "label": "No Auto-Commit Without Explicit Request", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "CLAUDE_sensitive_log_data_policy", "label": "Log Sanitization Policy \u2014 no tokens, cookies, IPs", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structured logs may include request IDs, sanitized paths, symbols, data sources, cache tier, result counts, status codes, and latency \u2014 but never tokens, cookies, full IPs, or wish message bodies."}, {"id": "CLAUDE_knowledge_article_seo_flow", "label": "Knowledge Article SEO Addition Checklist", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New knowledge articles require updating: KNOWLEDGE_ARTICLES, legacy_paths, Flask routes, vercel.json regex, frontend content/tab mapping, locale SEO copy, and SEO tests \u2014 a 7-step checklist to avoid partial deployment."}, {"id": "CLAUDE_backend_app_py", "label": "backend/app.py \u2014 Flask app entry, SEO, health, stats", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "auth